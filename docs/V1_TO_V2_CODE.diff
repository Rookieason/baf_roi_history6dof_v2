+    rate = rng.choice([-240., -30., 0., 0., 30., 240.], n)
+    x[:, 3] = (np.cumsum(rate / 30) + 180) % 360 - 180
+    x[:, 4:] = rng.normal(0, 2, (n, 2))
+    return timer, x
